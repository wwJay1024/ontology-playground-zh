        <rdfs:domain rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Promotion"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Product"/>
