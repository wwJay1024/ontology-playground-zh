    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-supply-chain-step-6-complete-model/signal-for-product">
        <rdfs:label>指向商品</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Demandsignal"/>
