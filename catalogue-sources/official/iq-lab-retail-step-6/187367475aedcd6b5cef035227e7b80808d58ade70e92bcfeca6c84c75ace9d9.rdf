    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-supply-chain-step-6-complete-model/forecast-for-product">
        <rdfs:label>预测商品</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Forecast"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Product"/>
        <rdfs:comment>某个商品的需求预测</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>forecast</ont:fromEntityId>
        <ont:toEntityId>product</ont:toEntityId>
