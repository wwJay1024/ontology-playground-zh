    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-supply-chain-step-6-complete-model/signal-in-region">
        <rdfs:label>来自区域</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Demandsignal"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Region"/>
