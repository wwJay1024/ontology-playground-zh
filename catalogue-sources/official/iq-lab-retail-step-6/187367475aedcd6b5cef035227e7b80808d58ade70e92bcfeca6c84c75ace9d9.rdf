        <rdfs:range rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Customer"/>
        <rdfs:comment>下单的客户</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>customer</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-supply-chain-step-6-complete-model/order-contains-product">
