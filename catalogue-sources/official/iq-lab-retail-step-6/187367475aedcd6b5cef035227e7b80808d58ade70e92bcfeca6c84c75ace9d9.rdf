        <rdfs:range rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Productcategory"/>
        <rdfs:comment>商品所属的分类</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>product</ont:fromEntityId>
        <ont:toEntityId>productcategory</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-supply-chain-step-6-complete-model/order-to-region">
        <rdfs:label>在区域履约</rdfs:label>
