    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-supply-chain-step-6-complete-model/inventory-at-warehouse">
        <rdfs:label>存放于仓库</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Inventory"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Warehouse"/>
