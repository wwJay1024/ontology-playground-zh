        <rdfs:range rdf:resource="http://example.org/ontology/retail-supply-chain-step-6-complete-model/Product"/>
        <rdfs:comment>该明细行对应的商品</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>orderline</ont:fromEntityId>
        <ont:toEntityId>product</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-supply-chain-step-6-complete-model/product-in-category">
