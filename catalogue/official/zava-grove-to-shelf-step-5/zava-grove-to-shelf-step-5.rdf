        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- Object Properties (cumulative + new participatesIn) -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/grower-owns-farm">
        <rdfs:label>拥有农场</rdfs:label>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>grower</ont:fromEntityId>
        <ont:toEntityId>farm</ont:toEntityId>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/farm-contains-plot">
        <rdfs:label>包含地块</rdfs:label>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>farm</ont:fromEntityId>
        <ont:toEntityId>plot</ont:toEntityId>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/plot-grows-fruitvariety">
        <rdfs:label>种植品种</rdfs:label>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>plot</ont:fromEntityId>
        <ont:toEntityId>fruitvariety</ont:toEntityId>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/harvestlot-fromplot-plot">
        <rdfs:label>来自地块</rdfs:label>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>harvestlot</ont:fromEntityId>
        <ont:toEntityId>plot</ont:toEntityId>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/harvestlot-ofvariety-fruitvariety">
        <rdfs:label>属于品种</rdfs:label>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>harvestlot</ont:fromEntityId>
        <ont:toEntityId>fruitvariety</ont:toEntityId>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/qualitycheck-checks-harvestlot">
        <rdfs:label>检查批次</rdfs:label>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>qualitycheck</ont:fromEntityId>
        <ont:toEntityId>harvestlot</ont:toEntityId>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/shipment-carries-harvestlot">
        <rdfs:label>运载批次</rdfs:label>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>shipment</ont:fromEntityId>
        <ont:toEntityId>harvestlot</ont:toEntityId>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/shipment-monitoredby-coldchainsensor">
        <rdfs:label>被传感器监测</rdfs:label>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>shipment</ont:fromEntityId>
        <ont:toEntityId>coldchainsensor</ont:toEntityId>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/shipment-deliveredto-retaildc">
        <rdfs:label>送达配送中心</rdfs:label>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>shipment</ont:fromEntityId>
        <ont:toEntityId>retaildc</ont:toEntityId>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/retaildc-supplies-store">
        <rdfs:label>供应门店</rdfs:label>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>retaildc</ont:fromEntityId>
        <ont:toEntityId>store</ont:toEntityId>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/store-places-order">
        <rdfs:label>下单</rdfs:label>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>store</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/order-forvariety-fruitvariety">
        <rdfs:label>订购品种</rdfs:label>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>fruitvariety</ont:toEntityId>
    </owl:ObjectProperty>

    <!-- New in step 5 -->
    <owl:ObjectProperty rdf:about="http://example.org/ontology/zava-grove-to-shelf-step-5/farm-participatesin-sustainabilityprogram">
        <rdfs:label>参与项目</rdfs:label>
        <rdfs:comment>农场可以加入零个或多个可持续发展项目（如 Zava Dreams）</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>farm</ont:fromEntityId>
        <ont:toEntityId>sustainabilityprogram</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
