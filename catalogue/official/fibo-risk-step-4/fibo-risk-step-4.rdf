<rdf:RDF
    xml:base="http://example.org/ontology/fibo-risk-step-4/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://example.org/ontology/fibo-risk-step-4/">

  <owl:Ontology rdf:about="">
    <rdfs:label>FIBO 风险实验 — 第 4 步</rdfs:label>
    <rdfs:comment>完整的 FIBO 风险管理模型，覆盖行业、地理、贷款分类与监管背景，并含跨领域关系。改编自 EDM Council FIBO。来源：https://github.com/edmcouncil/fibo — MIT 许可。</rdfs:comment>
  </owl:Ontology>

  <!-- Step 1: Industry Classification -->
  <owl:Class rdf:about="Sector">
    <rdfs:label>门类</rdfs:label>
    <rdfs:comment>按大类职能划分行业的最高层经济门类。</rdfs:comment>
    <ont:icon>🏢</ont:icon>
    <ont:color>#0078D4</ont:color>
  </owl:Class>

  <owl:Class rdf:about="Subsector">
    <rdfs:label>子门类</rdfs:label>
    <rdfs:comment>经济门类下的细分层次，用于更精细的分类。</rdfs:comment>
    <ont:icon>🏗️</ont:icon>
    <ont:color>#00A9E0</ont:color>
  </owl:Class>

  <owl:Class rdf:about="IndustryGroup">
    <rdfs:label>行业组</rdfs:label>
    <rdfs:comment>带 NAICS 编码的行业组，含气候敏感性与周期性属性，供风险分析使用。</rdfs:comment>
    <ont:icon>🏭</ont:icon>
    <ont:color>#486991</ont:color>
  </owl:Class>

  <!-- Step 2: Geographic Hierarchy -->
  <owl:Class rdf:about="Region">
    <rdfs:label>地区</rdfs:label>
    <rdfs:comment>用于宏观经济分析的大洲或地理区域。</rdfs:comment>
    <ont:icon>🌍</ont:icon>
    <ont:color>#107C10</ont:color>
  </owl:Class>

  <owl:Class rdf:about="Country">
    <rdfs:label>国家</rdfs:label>
    <rdfs:comment>具有经济区、货币与监管框架属性的主权国家。</rdfs:comment>
    <ont:icon>🏳️</ont:icon>
    <ont:color>#008272</ont:color>
  </owl:Class>

  <owl:Class rdf:about="Jurisdiction">
    <rdfs:label>辖区</rdfs:label>
    <rdfs:comment>国家以下的行政辖区，带飓风、洪水、地震与山火风险标记。</rdfs:comment>
    <ont:icon>📍</ont:icon>
    <ont:color>#00B294</ont:color>
  </owl:Class>

  <!-- Step 3: Loan Classification -->
  <owl:Class rdf:about="ConcentrationCategory">
    <rdfs:label>集中度类别</rdfs:label>
    <rdfs:comment>按 OCC/FDIC 指引划分的监管集中度分组，用于投资组合风险管理。</rdfs:comment>
    <ont:icon>📊</ont:icon>
    <ont:color>#D83B01</ont:color>
  </owl:Class>

  <owl:Class rdf:about="LoanType">
    <rdfs:label>贷款类型</rdfs:label>
    <rdfs:comment>贷款产品分类，含巴塞尔 III 风险权重、监管处理方式与资本层级。</rdfs:comment>
    <ont:icon>💰</ont:icon>
    <ont:color>#E81123</ont:color>
  </owl:Class>

  <owl:Class rdf:about="CollateralType">
    <rdfs:label>抵押物类型</rdfs:label>
    <rdfs:comment>抵押资产类别，含回收预期与集中度归属。</rdfs:comment>
    <ont:icon>🏠</ont:icon>
    <ont:color>#FF8C00</ont:color>
  </owl:Class>

  <!-- New in Step 4: Regulatory Context -->
  <owl:Class rdf:about="Regulation">
    <rdfs:label>监管规定</rdfs:label>
    <rdfs:comment>银行监管机构（OCC、FDIC、巴塞尔委员会）发布、约束组合风险的监管框架。</rdfs:comment>
    <ont:icon>⚖️</ont:icon>
    <ont:color>#5C2D91</ont:color>
  </owl:Class>

  <owl:Class rdf:about="RegulatoryLimit">
    <rdfs:label>监管限额</rdfs:label>
    <rdfs:comment>监管规定对组合集中度、风险敞口或资本比率设定的量化阈值。</rdfs:comment>
    <ont:icon>🚨</ont:icon>
    <ont:color>#8764B8</ont:color>
  </owl:Class>

  <!-- Step 1 Properties -->
  <owl:DatatypeProperty rdf:about="sectorCode">
    <rdfs:label>sectorCode</rdfs:label>
    <rdfs:domain rdf:resource="Sector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="sectorName">
    <rdfs:label>sectorName</rdfs:label>
    <rdfs:domain rdf:resource="Sector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="sectorDescription">
    <rdfs:label>description</rdfs:label>
    <rdfs:domain rdf:resource="Sector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="subsectorCode">
    <rdfs:label>subsectorCode</rdfs:label>
    <rdfs:domain rdf:resource="Subsector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="subsectorName">
    <rdfs:label>subsectorName</rdfs:label>
    <rdfs:domain rdf:resource="Subsector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="naicsCode">
    <rdfs:label>naicsCode</rdfs:label>
    <rdfs:domain rdf:resource="IndustryGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="industryName">
    <rdfs:label>name</rdfs:label>
    <rdfs:domain rdf:resource="IndustryGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="cyclicality">
    <rdfs:label>cyclicality</rdfs:label>
    <rdfs:domain rdf:resource="IndustryGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="climateSensitivity">
    <rdfs:label>climateSensitivity</rdfs:label>
    <rdfs:domain rdf:resource="IndustryGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="essentialServices">
    <rdfs:label>essentialServices</rdfs:label>
    <rdfs:domain rdf:resource="IndustryGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <ont:propertyType>boolean</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="industryDescription">
    <rdfs:label>description</rdfs:label>
    <rdfs:domain rdf:resource="IndustryGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- Step 2 Properties -->
  <owl:DatatypeProperty rdf:about="regionCode">
    <rdfs:label>regionCode</rdfs:label>
    <rdfs:domain rdf:resource="Region"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="regionName">
