{
  "schemaVersion": 1,
  "id": "community/vaibhavius/baby-routine-tracking",
  "ontology": {
    "name": "Baby Routine Tracking",
    "description": "Models a baby’s daily routine by capturing caregiver-logged activities (sleep, feeding, diaper changes), associated observations, and emerging patterns to enable structured tracking and insights into the baby’s behavior.",
    "entityTypes": [
      {
        "id": "new-entity-16",
        "name": "DiaperChange",
        "description": "Represents a diaper change event, recording the type and condition of the diaper.",
        "icon": "⚡",
        "color": "#008272",
        "properties": [
          {
            "name": "diaperchange_id",
            "type": "integer",
            "isIdentifier": true
          },
          {
            "name": "diaper_type",
            "type": "string"
          },
          {
            "name": "change_time",
            "type": "datetime"
          }
        ]
      },
      {
        "id": "new-entity-15",
        "name": "feeding",
        "description": "Represents a feeding event, including details such as type of feed (milk/solid) and quantity consumed.",
        "icon": "⚡",
        "color": "#E81123",
        "properties": [
          {
            "name": "feeding_id",
            "type": "integer",
            "isIdentifier": true
          },
          {
            "name": "feeding_type",
            "type": "string"
          },
          {
            "name": "feeding_quantity",
            "type": "integer"
          }
        ]
      },
      {
        "id": "new-entity-14",
        "name": "sleep",
        "description": "Represents a sleep event, capturing the duration and timing of the baby’s sleep",
        "icon": "⚡",
        "color": "#FFB900",
        "properties": [
          {
            "name": "sleep_start_time",
            "type": "datetime"
          },
          {
            "name": "sleep_end_time",
            "type": "datetime"
          },
          {
            "name": "sleep_id",
            "type": "string",
            "isIdentifier": true
          }
        ]
      },
      {
        "id": "new-entity-12",
        "name": "Routine_Pattern",
        "description": "Represents a routine pattern summary that can be derived from the observations",
        "icon": "📋",
        "color": "#D83B01",
        "properties": [
          {
            "name": "pattern_id",
            "type": "integer",
            "isIdentifier": true
          },
          {
            "name": "summary",
            "type": "string"
          }
        ]
      },
      {
        "id": "new-entity-11",
        "name": "Baby",
        "description": "Represents the infant whose daily routine activities (sleep, feeding, diaper changes) are being tracked and analyzed.",
        "icon": "👤",
        "color": "#5C2D91",
        "properties": [
          {
            "name": "baby_id",
            "type": "integer",
            "isIdentifier": true
          },
          {
            "name": "baby_name",
            "type": "string"
          },
          {
            "name": "age_months",
            "type": "string"
          }
        ]
      },
      {
        "id": "new-entity-10",
        "name": "Care_Giver",
        "description": "Represents the individual (parent or guardian) responsible for logging activities and monitoring the baby’s routine.",
        "icon": "👤",
        "color": "#FFB900",
        "properties": [
          {
            "name": "caregiver_id",
            "type": "integer",
            "isIdentifier": true
          },
          {
            "name": "caregiver_name",
            "type": "string"
          }
        ]
      },
      {
        "id": "new-entity-8",
        "name": "Observation",
        "description": "Represents qualitative insights recorded during or after an activity, such as the baby’s mood (happy, irritated, stimulated etc) or other behaviors.",
        "icon": "📝",
        "color": "#00A9E0",
        "properties": [
          {
            "name": "mood",
            "type": "string"
          },
          {
            "name": "observation_id",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "notes",
            "type": "string"
          }
        ]
      },
      {
        "id": "new-entity-3",
        "name": "Activity",
        "description": "Represents any routine event performed for the baby, serving as the central entity for tracking sleep, feeding, and diaper-related activities.",
        "icon": "📈",
        "color": "#107C10",
        "properties": [
          {
            "name": "activity_id",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "duration",
            "type": "integer"
          },
          {
            "name": "activity_type",
            "type": "string"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "rel-relates-to-18",
        "name": "is_an",
        "from": "new-entity-14",
        "to": "new-entity-3",
        "cardinality": "many-to-one",
        "description": "Sleep is a sub-activity"
      },
      {
        "id": "rel-relates-to-17",
        "name": "is_an",
        "from": "new-entity-16",
        "to": "new-entity-3",
        "cardinality": "many-to-one",
        "description": "Diaper Change is a sub-activity"
      },
      {
        "id": "rel-relates-to-16",
        "name": "is_a",
        "from": "new-entity-15",
        "to": "new-entity-3",
        "cardinality": "one-to-one",
        "description": "Feeding is a sub-activity"
      },
      {
        "id": "rel-relates-to-15",
        "name": "derived_from",
        "from": "new-entity-12",
        "to": "new-entity-3",
        "cardinality": "one-to-many",
        "description": "Routine can be derived from the activities that are logged"
      },
      {
        "id": "rel-relates-to-14",
        "name": "monitors",
        "from": "new-entity-10",
        "to": "new-entity-11",
        "cardinality": "one-to-one",
        "description": "Care giver monitors the infant"
      },
      {
        "id": "rel-relates-to-13",
        "name": "has_observation",
        "from": "new-entity-3",
        "to": "new-entity-8",
        "cardinality": "one-to-many",
        "description": "Each activity has certain observations"
      },
      {
        "id": "rel-relates-to-11",
        "name": "performed_for",
        "from": "new-entity-3",
        "to": "new-entity-11",
        "cardinality": "many-to-one",
        "description": "Activities (eg diaper change, feeding, putting to sleep) are performed for baby "
      },
      {
        "id": "rel-relates-to-9",
        "name": "logs",
        "from": "new-entity-10",
        "to": "new-entity-3",
        "cardinality": "one-to-many",
        "description": "Caregiver logs all the activities."
      }
    ],
    "rdfMetadata": {
      "ontologyIri": "http://example.org/ontology/baby-routine-tracking/",
      "imports": [],
      "preservedSourceFeatures": []
    }
  },
  "bindings": []
}
