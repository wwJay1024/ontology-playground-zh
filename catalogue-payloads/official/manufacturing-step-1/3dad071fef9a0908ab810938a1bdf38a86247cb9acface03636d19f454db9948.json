        "name": "Machine",
        "description": "A manufacturing machine on the factory floor",
        "icon": "🏭",
        "color": "#0078D4",
        "properties": [
          {
            "name": "machineId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "model",
            "type": "string"
          },
          {
            "name": "location",
            "type": "string"
          },
          {
            "name": "status",
            "type": "string"
          },
          {
            "name": "lastMaintenance",
            "type": "date"
          }
        ]
      },
      {
        "id": "sensor",
        "name": "Sensor",
        "description": "A sensor device that monitors machine parameters",
