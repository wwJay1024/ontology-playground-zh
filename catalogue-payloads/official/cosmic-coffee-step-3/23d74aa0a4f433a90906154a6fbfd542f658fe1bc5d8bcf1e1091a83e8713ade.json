{
  "schemaVersion": 1,
  "id": "official/cosmic-coffee-step-3",
  "ontology": {
    "name": "Fourth Coffee – Step 3",
    "description": "Full supply-chain model adding Supplier and Shipment to complete the bean-to-cup journey.",
    "entityTypes": [
      {
        "id": "customer",
        "name": "Customer",
        "description": "A loyalty-program member who places orders",
        "icon": "👤",
        "color": "#0078D4",
        "properties": [
          {
            "name": "customerId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "email",
            "type": "string"
          },
          {
            "name": "loyaltyTier",
            "type": "enum",
            "values": [
              "Bronze",
              "Silver",
              "Gold",
              "Platinum"
            ]
          },
          {
            "name": "joinDate",
            "type": "date"
          },
          {
            "name": "totalSpend",
            "type": "decimal",
            "unit": "USD"
          }
        ]
      },
      {
        "id": "order",
        "name": "Order",
        "description": "A purchase transaction containing one or more products",
        "icon": "🧾",
        "color": "#107C10",
        "properties": [
          {
            "name": "orderId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "timestamp",
            "type": "datetime"
          },
          {
            "name": "total",
            "type": "decimal",
            "unit": "USD"
          },
          {
            "name": "status",
            "type": "enum",
            "values": [
              "Pending",
              "Preparing",
              "Ready",
              "Completed",
              "Cancelled"
            ]
          },
          {
            "name": "paymentMethod",
            "type": "enum",
            "values": [
              "Card",
              "Cash",
              "Mobile",
              "Gift Card"
            ]
          }
        ]
      },
      {
        "id": "product",
        "name": "Product",
        "description": "A menu item or merchandise available for sale",
        "icon": "☕",
        "color": "#5C2D91",
        "properties": [
          {
            "name": "productId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "category",
            "type": "enum",
            "values": [
              "Espresso",
              "Brewed",
              "Cold Brew",
              "Tea",
              "Food",
              "Merchandise"
            ]
          },
          {
            "name": "price",
            "type": "decimal",
            "unit": "USD"
          },
          {
            "name": "origin",
            "type": "string"
          },
          {
            "name": "isOrganic",
            "type": "boolean"
          }
        ]
      },
      {
        "id": "store",
        "name": "Store",
        "description": "A physical retail location where orders are prepared and served",
        "icon": "🏪",
        "color": "#FFB900",
        "properties": [
          {
            "name": "storeId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "city",
            "type": "string"
          },
          {
            "name": "state",
            "type": "string"
          },
          {
            "name": "openDate",
            "type": "date"
          },
          {
            "name": "capacity",
            "type": "integer"
          }
        ]
      },
      {
        "id": "supplier",
        "name": "Supplier",
        "description": "A vendor that provides coffee beans, ingredients, or merchandise",
        "icon": "🚚",
        "color": "#D83B01",
        "properties": [
          {
            "name": "supplierId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "country",
            "type": "string"
          },
          {
            "name": "certification",
            "type": "enum",
            "values": [
              "Fair Trade",
              "Rainforest Alliance",
              "Organic",
              "Direct Trade",
              "None"
            ]
          },
          {
            "name": "rating",
            "type": "decimal"
          }
        ]
      },
      {
        "id": "shipment",
        "name": "Shipment",
        "description": "A delivery of products from a supplier to a store",
        "icon": "📦",
        "color": "#00A9E0",
        "properties": [
          {
            "name": "shipmentId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "dispatchDate",
            "type": "date"
          },
          {
            "name": "arrivalDate",
            "type": "date"
          },
          {
            "name": "status",
            "type": "enum",
            "values": [
              "In Transit",
              "Delivered",
              "Delayed"
            ]
          },
          {
            "name": "weight",
            "type": "decimal",
            "unit": "kg"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "customer_places_order",
        "name": "places",
        "from": "customer",
        "to": "order",
        "cardinality": "one-to-many",
        "description": "A customer places one or more orders"
      },
      {
        "id": "order_contains_product",
        "name": "contains",
        "from": "order",
        "to": "product",
        "cardinality": "many-to-many",
        "description": "An order contains one or more products"
      },
      {
        "id": "order_processed_at_store",
        "name": "processedAt",
        "from": "order",
        "to": "store",
        "cardinality": "many-to-one",
        "description": "An order is processed at a specific store"
      },
      {
        "id": "product_sourced_from_supplier",
        "name": "sourcedFrom",
        "from": "product",
        "to": "supplier",
        "cardinality": "many-to-one",
        "description": "A product is sourced from a supplier"
      },
      {
        "id": "shipment_from_supplier",
        "name": "sentBy",
        "from": "shipment",
        "to": "supplier",
        "cardinality": "many-to-one",
        "description": "A shipment is sent by a supplier"
      },
      {
        "id": "shipment_to_store",
        "name": "deliveredTo",
        "from": "shipment",
        "to": "store",
        "cardinality": "many-to-one",
        "description": "A shipment is delivered to a store"
      },
      {
        "id": "shipment_contains_product",
        "name": "carries",
        "from": "shipment",
        "to": "product",
        "cardinality": "many-to-many",
        "description": "A shipment carries one or more products"
      }
    ],
    "rdfMetadata": {
      "ontologyIri": "http://example.org/ontology/cosmic-coffee-step-3/",
      "imports": [],
      "preservedSourceFeatures": []
    }
  },
  "bindings": []
}
