{
  "schemaVersion": 1,
  "id": "official/fibo-loans-step-2",
  "ontology": {
    "name": "FIBO 贷款实验 — 第 2 步",
    "description": "在核心贷款模型上增加抵押物与还款计划概念。改编自 EDM Council FIBO。来源：https://github.com/edmcouncil/fibo — MIT 许可。",
    "entityTypes": [
      {
        "id": "loan",
        "name": "贷款",
        "description": "向借款人发放、并按合同条款偿还的债务工具。",
        "icon": "📄",
        "color": "#00A9E0",
        "properties": [
          {
            "name": "loanId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "principalAmount",
            "type": "decimal",
            "unit": "USD"
          },
          {
            "name": "isInterestOnly",
            "type": "boolean"
          }
        ]
      },
      {
        "id": "borrower",
        "name": "借款人",
        "description": "收取资金并承担还款义务的一方。",
        "icon": "👤",
        "color": "#0078D4",
        "properties": [
          {
            "name": "borrowerId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "creditScore",
            "type": "integer"
          }
        ]
      },
      {
        "id": "lender",
        "name": "出借人",
        "description": "按贷款协议条款提供资金或授信的一方。",
        "icon": "🏦",
        "color": "#107C10",
        "properties": [
          {
            "name": "lenderId",
            "type": "string",
            "isIdentifier": true
          }
        ]
      },
      {
        "id": "collateral",
        "name": "抵押物",
        "description": "为担保还款义务而质押的资产。改编自 fibo-fbc-dae-dbt:Collateral。",
        "icon": "🏠",
        "color": "#D83B01",
        "properties": [
          {
            "name": "assetType",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "appraisedValue",
            "type": "decimal",
            "unit": "USD"
          }
        ]
      },
      {
        "id": "loanPaymentSchedule",
        "name": "贷款还款计划",
        "description": "规定到期日与各期应还金额的定期还款安排。改编自 fibo-loan-ln-ln:LoanPaymentSchedule。",
        "icon": "🗓️",
        "color": "#5C2D91",
        "properties": [
          {
            "name": "scheduleId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "expectedPayments",
            "type": "integer"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "owedBy",
        "name": "由…负担",
        "from": "loan",
        "to": "borrower",
        "cardinality": "many-to-one",
        "description": "指明贷款的还款义务人。"
      },
      {
        "id": "originatedBy",
        "name": "由…发起",
        "from": "loan",
        "to": "lender",
        "cardinality": "many-to-one",
        "description": "指明发起该笔贷款的出借机构。"
      },
      {
        "id": "securedBy",
        "name": "由…担保",
        "from": "loan",
        "to": "collateral",
        "cardinality": "one-to-many",
        "description": "指明有担保贷款所对应的质押资产。"
      },
      {
        "id": "repaidBySchedule",
        "name": "按计划还款",
        "from": "loan",
        "to": "loanPaymentSchedule",
        "cardinality": "one-to-one",
        "description": "指明贷款对应的还款计划。"
      }
    ],
    "rdfMetadata": {
      "imports": [],
      "preservedSourceFeatures": []
    }
  },
  "bindings": []
}
