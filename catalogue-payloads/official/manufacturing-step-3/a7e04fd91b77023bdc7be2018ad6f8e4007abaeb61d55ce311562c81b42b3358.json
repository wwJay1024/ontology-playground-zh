{
  "schemaVersion": 1,
  "id": "official/manufacturing-step-3",
  "ontology": {
    "name": "Imported Ontology",
    "description": "",
    "entityTypes": [
      {
        "id": "machine",
        "name": "设备",
        "description": "车间里的一台生产设备",
        "icon": "🏭",
        "color": "#0078D4",
        "properties": [
          {
            "name": "machineId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "model",
            "type": "string"
          },
          {
            "name": "location",
            "type": "string"
          },
          {
            "name": "status",
            "type": "string"
          },
          {
            "name": "lastMaintenance",
            "type": "date"
          }
        ]
      },
      {
        "id": "sensor",
        "name": "传感器",
        "description": "监测设备运行参数的传感器",
        "icon": "📡",
        "color": "#00B7C3",
        "properties": [
          {
            "name": "sensorId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "type",
            "type": "string"
          },
          {
            "name": "unit",
            "type": "string"
          },
          {
            "name": "minThreshold",
            "type": "decimal"
          },
          {
            "name": "maxThreshold",
            "type": "decimal"
          }
        ]
      },
      {
        "id": "workorder",
        "name": "工单",
        "description": "为生产某个产品而下达的工单",
        "icon": "📋",
        "color": "#FFB900",
        "properties": [
          {
            "name": "workOrderId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "product",
            "type": "string"
          },
          {
            "name": "quantity",
            "type": "integer"
          },
          {
            "name": "priority",
            "type": "string"
          },
          {
            "name": "dueDate",
            "type": "date"
          }
        ]
      },
      {
        "id": "part",
        "name": "零件",
        "description": "生产中使用的零部件或备件",
        "icon": "🔩",
        "color": "#107C10",
        "properties": [
          {
            "name": "partNumber",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "stockLevel",
            "type": "integer"
          },
          {
            "name": "reorderPoint",
            "type": "integer"
          },
          {
            "name": "unitCost",
            "type": "decimal",
            "unit": "USD"
          }
        ]
      },
      {
        "id": "qualitycheck",
        "name": "质检",
        "description": "针对工单执行的一次质检",
        "icon": "✅",
        "color": "#8764B8",
        "properties": [
          {
            "name": "checkId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "timestamp",
            "type": "datetime"
          },
          {
            "name": "passed",
            "type": "boolean"
          },
          {
            "name": "defectType",
            "type": "string"
          },
          {
            "name": "inspector",
            "type": "string"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "machine_has_sensor",
        "name": "由…监测",
        "from": "machine",
        "to": "sensor",
        "cardinality": "one-to-many",
        "description": "设备上安装的传感器"
      },
      {
        "id": "machine_runs",
        "name": "执行",
        "from": "machine",
        "to": "workorder",
        "cardinality": "one-to-many",
        "description": "设备执行的工单"
      },
      {
        "id": "workorder_uses",
        "name": "耗用",
        "from": "workorder",
        "to": "part",
        "cardinality": "many-to-many",
        "description": "耗用的零件"
      },
      {
        "id": "machine_maintains",
        "name": "需要备件",
        "from": "machine",
        "to": "part",
        "cardinality": "many-to-many",
        "description": "所需备件"
      },
      {
        "id": "workorder_checked",
        "name": "由…质检",
        "from": "workorder",
        "to": "qualitycheck",
        "cardinality": "one-to-many",
        "description": "质检记录"
      }
    ]
  },
  "bindings": []
}
