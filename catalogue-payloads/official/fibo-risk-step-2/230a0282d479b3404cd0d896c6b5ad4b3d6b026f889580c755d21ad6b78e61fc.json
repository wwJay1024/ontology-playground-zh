    "relationships": [
      {
        "id": "partOfSector",
        "name": "partOfSector",
        "from": "subsector",
        "to": "sector",
        "cardinality": "many-to-one",
        "description": "Links a subsector to its parent economic sector."
      },
      {
        "id": "belongsToSubsector",
        "name": "belongsToSubsector",
        "from": "industryGroup",
        "to": "subsector",
        "cardinality": "many-to-one",
        "description": "Links an industry group to its parent subsector."
      },
      {
        "id": "inCountry",
