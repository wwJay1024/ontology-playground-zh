          },
          {
            "name": "essentialServices",
            "type": "boolean"
          },
          {
            "name": "description",
            "type": "string"
          }
        ]
      },
      {
        "id": "region",
        "name": "Region",
        "description": "Continental or geographic region grouping for macroeconomic analysis.",
        "icon": "🌍",
        "color": "#107C10",
        "properties": [
          {
            "name": "regionCode",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "regionName",
            "type": "string"
          },
          {
            "name": "description",
            "type": "string"
          },
          {
            "name": "disasterProfile",
            "type": "string"
          }
        ]
      },
      {
        "id": "country",
        "name": "Country",
        "description": "Nation-state with economic zone, currency, and regulatory framework attributes.",
        "icon": "🏳️",
        "color": "#008272",
        "properties": [
          {
            "name": "countryCode",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "countryName",
            "type": "string"
          },
          {
            "name": "economicZone",
            "type": "string"
          },
          {
            "name": "currency",
            "type": "string"
          },
          {
            "name": "regulatoryFramework",
            "type": "string"
          }
        ]
      },
      {
        "id": "jurisdiction",
        "name": "Jurisdiction",
        "description": "Subnational jurisdiction with disaster-zone flags for hurricane, flood, earthquake, and wildfire risk.",
        "icon": "📍",
        "color": "#00B294",
        "properties": [
          {
            "name": "code",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "hurricaneZone",
            "type": "boolean"
          },
          {
            "name": "floodZone",
            "type": "boolean"
          },
          {
            "name": "earthquakeZone",
            "type": "boolean"
          },
          {
            "name": "wildfireZone",
            "type": "boolean"
          },
          {
            "name": "coastal",
            "type": "boolean"
          },
          {
            "name": "latitude",
            "type": "decimal"
          },
          {
            "name": "longitude",
            "type": "decimal"
          }
        ]
      }
