{
  "schemaVersion": 1,
  "id": "official/fibo-loans-step-1",
  "ontology": {
    "name": "FIBO 贷款实验 — 第 1 步",
    "description": "改编自 EDM Council FIBO LOAN/LoansGeneral/Loans 的核心贷款参与方与义务模型。来源：https://github.com/edmcouncil/fibo — MIT 许可。",
    "entityTypes": [
      {
        "id": "loan",
        "name": "贷款",
        "description": "向借款人发放、并按合同条款偿还的债务工具。",
        "icon": "📄",
        "color": "#00A9E0",
        "properties": [
          {
            "name": "loanId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "principalAmount",
            "type": "decimal",
            "unit": "USD"
          },
          {
            "name": "isInterestOnly",
            "type": "boolean"
          }
        ]
      },
      {
        "id": "borrower",
        "name": "借款人",
        "description": "收取资金并承担还款义务的一方。",
        "icon": "👤",
        "color": "#0078D4",
        "properties": [
          {
            "name": "borrowerId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "creditScore",
            "type": "integer"
          }
        ]
      },
      {
        "id": "lender",
        "name": "出借人",
        "description": "按贷款协议条款提供资金或授信的一方。",
        "icon": "🏦",
        "color": "#107C10",
        "properties": [
          {
            "name": "lenderId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "lenderType",
            "type": "string"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "owedBy",
        "name": "由…负担",
        "from": "loan",
        "to": "borrower",
        "cardinality": "many-to-one",
        "description": "指明贷款的还款义务人。"
      },
      {
        "id": "originatedBy",
        "name": "由…发起",
        "from": "loan",
        "to": "lender",
        "cardinality": "many-to-one",
        "description": "指明发起该笔贷款的出借机构。"
      }
    ],
    "rdfMetadata": {
      "imports": [],
      "preservedSourceFeatures": []
    }
  },
  "bindings": []
}
