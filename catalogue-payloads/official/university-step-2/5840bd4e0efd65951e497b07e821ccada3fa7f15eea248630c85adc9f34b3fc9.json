{
  "schemaVersion": 1,
  "id": "official/university-step-2",
  "ontology": {
    "name": "University System – Step 2",
    "description": "Adds Professor entity with teaching and advising relationships.",
    "entityTypes": [
      {
        "id": "student",
        "name": "Student",
        "description": "A student enrolled at the university",
        "icon": "🎓",
        "color": "#0078D4",
        "properties": [
          {
            "name": "studentId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "major",
            "type": "string"
          },
          {
            "name": "gpa",
            "type": "decimal"
          },
          {
            "name": "enrollmentYear",
            "type": "integer"
          }
        ]
      },
      {
        "id": "course",
        "name": "Course",
        "description": "An academic course offered by the university",
        "icon": "📚",
        "color": "#FFB900",
        "properties": [
          {
            "name": "courseCode",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "title",
            "type": "string"
          },
          {
            "name": "credits",
            "type": "integer"
          },
          {
            "name": "level",
            "type": "string"
          },
          {
            "name": "maxEnrollment",
            "type": "integer"
          }
        ]
      },
      {
        "id": "enrollment",
        "name": "Enrollment",
        "description": "A student's registration in a specific course",
        "icon": "📝",
        "color": "#00B7C3",
        "properties": [
          {
            "name": "enrollmentId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "semester",
            "type": "string"
          },
          {
            "name": "grade",
            "type": "string"
          },
          {
            "name": "status",
            "type": "string"
          }
        ]
      },
      {
        "id": "professor",
        "name": "Professor",
        "description": "A faculty member who teaches courses and advises students",
        "icon": "👨‍🏫",
        "color": "#107C10",
        "properties": [
          {
            "name": "facultyId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "department",
            "type": "string"
          },
          {
            "name": "tenure",
            "type": "boolean"
          },
          {
            "name": "researchArea",
            "type": "string"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "student_enrolls",
        "name": "enrolled_in",
        "from": "student",
        "to": "enrollment",
        "cardinality": "one-to-many",
        "description": "Student registrations"
      },
      {
        "id": "enrollment_for",
        "name": "for_course",
        "from": "enrollment",
        "to": "course",
        "cardinality": "many-to-one",
        "description": "Course enrollment"
      },
      {
        "id": "prof_teaches",
        "name": "teaches",
        "from": "professor",
        "to": "course",
        "cardinality": "one-to-many",
        "description": "Courses taught"
      },
      {
        "id": "student_advised",
        "name": "advised_by",
        "from": "student",
        "to": "professor",
        "cardinality": "many-to-one",
        "description": "Academic advisor"
      }
    ],
    "rdfMetadata": {
      "imports": [],
      "preservedSourceFeatures": []
    }
  },
  "bindings": []
}
