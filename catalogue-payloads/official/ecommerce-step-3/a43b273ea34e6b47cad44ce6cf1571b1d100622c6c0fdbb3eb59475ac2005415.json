{
  "schemaVersion": 1,
  "id": "official/ecommerce-step-3",
  "ontology": {
    "name": "E-Commerce Platform – Step 3",
    "description": "Complete model adding Reviews for product feedback and buyer engagement.",
    "entityTypes": [
      {
        "id": "buyer",
        "name": "Buyer",
        "description": "A customer who purchases products on the platform.",
        "icon": "🛒",
        "color": "#0078D4",
        "properties": [
          {
            "name": "buyerId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "email",
            "type": "string"
          },
          {
            "name": "memberSince",
            "type": "date"
          },
          {
            "name": "loyaltyTier",
            "type": "string"
          },
          {
            "name": "totalSpent",
            "type": "decimal",
            "unit": "USD"
          }
        ]
      },
      {
        "id": "product",
        "name": "Product",
        "description": "An item available for purchase on the platform.",
        "icon": "📦",
        "color": "#107C10",
        "properties": [
          {
            "name": "sku",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "category",
            "type": "string"
          },
          {
            "name": "price",
            "type": "decimal",
            "unit": "USD"
          },
          {
            "name": "stockQty",
            "type": "integer"
          }
        ]
      },
      {
        "id": "order",
        "name": "Order",
        "description": "A purchase order placed by a buyer.",
        "icon": "📋",
        "color": "#8764B8",
        "properties": [
          {
            "name": "orderId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "orderDate",
            "type": "datetime"
          },
          {
            "name": "status",
            "type": "string"
          },
          {
            "name": "total",
            "type": "decimal",
            "unit": "USD"
          },
          {
            "name": "shippingMethod",
            "type": "string"
          }
        ]
      },
      {
        "id": "shoppingCart",
        "name": "ShoppingCart",
        "description": "A temporary collection of products a buyer intends to purchase.",
        "icon": "🛍️",
        "color": "#FFB900",
        "properties": [
          {
            "name": "cartId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "createdAt",
            "type": "datetime"
          },
          {
            "name": "itemCount",
            "type": "integer"
          },
          {
            "name": "subtotal",
            "type": "decimal",
            "unit": "USD"
          }
        ]
      },
      {
        "id": "review",
        "name": "Review",
        "description": "A product review written by a buyer.",
        "icon": "⭐",
        "color": "#00B7C3",
        "properties": [
          {
            "name": "reviewId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "rating",
            "type": "integer"
          },
          {
            "name": "title",
            "type": "string"
          },
          {
            "name": "body",
            "type": "string"
          },
          {
            "name": "verified",
            "type": "boolean"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "places",
        "name": "places",
        "from": "buyer",
        "to": "order",
        "cardinality": "one-to-many",
        "description": "A buyer places an order."
      },
      {
        "id": "includes",
        "name": "includes",
        "from": "order",
        "to": "product",
        "cardinality": "many-to-many",
        "description": "An order includes one or more products."
      },
      {
        "id": "has_cart",
        "name": "has_cart",
        "from": "buyer",
        "to": "shoppingCart",
        "cardinality": "one-to-one",
        "description": "A buyer has a shopping cart."
      },
      {
        "id": "contains",
        "name": "contains",
        "from": "shoppingCart",
        "to": "product",
        "cardinality": "many-to-many",
        "description": "A shopping cart contains products."
      },
      {
        "id": "writes",
        "name": "writes",
        "from": "buyer",
        "to": "review",
        "cardinality": "one-to-many",
        "description": "A buyer writes a product review."
      },
      {
        "id": "reviews",
        "name": "reviews",
        "from": "review",
        "to": "product",
        "cardinality": "many-to-one",
        "description": "A review is about a specific product."
      }
    ],
    "rdfMetadata": {
      "imports": [],
      "preservedSourceFeatures": []
    }
  },
  "bindings": []
}
