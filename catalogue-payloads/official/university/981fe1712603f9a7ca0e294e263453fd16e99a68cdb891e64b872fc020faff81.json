{
  "schemaVersion": 1,
  "id": "official/university",
  "ontology": {
    "name": "高校系统",
    "description": "涵盖学生、课程与教职员工的高校机构",
    "entityTypes": [
      {
        "id": "student",
        "name": "学生",
        "description": "在读学生",
        "icon": "🎓",
        "color": "#0078D4",
        "properties": [
          {
            "name": "studentId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "major",
            "type": "string"
          },
          {
            "name": "gpa",
            "type": "decimal"
          },
          {
            "name": "enrollmentYear",
            "type": "integer"
          }
        ]
      },
      {
        "id": "professor",
        "name": "教授",
        "description": "教职员工",
        "icon": "👨‍🏫",
        "color": "#107C10",
        "properties": [
          {
            "name": "facultyId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "department",
            "type": "string"
          },
          {
            "name": "tenure",
            "type": "boolean"
          },
          {
            "name": "researchArea",
            "type": "string"
          }
        ]
      },
      {
        "id": "course",
        "name": "课程",
        "description": "开设的课程",
        "icon": "📚",
        "color": "#FFB900",
        "properties": [
          {
            "name": "courseCode",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "title",
            "type": "string"
          },
          {
            "name": "credits",
            "type": "integer"
          },
          {
            "name": "level",
            "type": "string"
          },
          {
            "name": "maxEnrollment",
            "type": "integer"
          }
        ]
      },
      {
        "id": "department",
        "name": "院系",
        "description": "教学单位",
        "icon": "🏛️",
        "color": "#8764B8",
        "properties": [
          {
            "name": "deptCode",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "building",
            "type": "string"
          },
          {
            "name": "budget",
            "type": "decimal",
            "unit": "USD"
          }
        ]
      },
      {
        "id": "enrollment",
        "name": "选课",
        "description": "课程注册记录",
        "icon": "📝",
        "color": "#00B7C3",
        "properties": [
          {
            "name": "enrollmentId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "semester",
            "type": "string"
          },
          {
            "name": "grade",
            "type": "string"
          },
          {
            "name": "status",
            "type": "string"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "student_enrolls",
        "name": "选修",
        "from": "student",
        "to": "enrollment",
        "cardinality": "one-to-many",
        "description": "学生的选课记录"
      },
      {
        "id": "enrollment_for",
        "name": "对应课程",
        "from": "enrollment",
        "to": "course",
        "cardinality": "many-to-one",
        "description": "课程的选课记录"
      },
      {
        "id": "prof_teaches",
        "name": "授课",
        "from": "professor",
        "to": "course",
        "cardinality": "one-to-many",
        "description": "讲授的课程"
      },
      {
        "id": "prof_belongs",
        "name": "隶属院系",
        "from": "professor",
        "to": "department",
        "cardinality": "many-to-one",
        "description": "教职员工所属院系"
      },
      {
        "id": "course_offered",
        "name": "由…开设",
        "from": "course",
        "to": "department",
        "cardinality": "many-to-one",
        "description": "课程所属院系"
      },
      {
        "id": "student_advised",
        "name": "由…指导",
        "from": "student",
        "to": "professor",
        "cardinality": "many-to-one",
        "description": "学业导师"
      }
    ],
    "rdfMetadata": {
      "ontologyIri": "http://example.org/ontology/university-system/",
      "imports": [],
      "preservedSourceFeatures": []
    }
  },
  "bindings": []
}
