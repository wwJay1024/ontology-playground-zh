{
  "schemaVersion": 1,
  "id": "official/iq-lab-retail-step-1",
  "ontology": {
    "name": "零售供应链 — 第 1 步：核心交易",
    "description": "客户、订单、商品：基础实体",
    "entityTypes": [
      {
        "id": "customer",
        "name": "客户",
        "description": "与订单关联的买家",
        "icon": "👤",
        "color": "#0078D4",
        "properties": [
          {
            "name": "customerId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "email",
            "type": "string"
          },
          {
            "name": "loyaltyTier",
            "type": "string"
          },
          {
            "name": "lifetimeValue",
            "type": "decimal",
            "unit": "USD"
          }
        ]
      },
      {
        "id": "order",
        "name": "订单",
        "description": "客户的一次购买交易",
        "icon": "📋",
        "color": "#107C10",
        "properties": [
          {
            "name": "orderId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "orderDate",
            "type": "datetime"
          },
          {
            "name": "status",
            "type": "string"
          },
          {
            "name": "totalAmount",
            "type": "decimal",
            "unit": "USD"
          }
        ]
      },
      {
        "id": "product",
        "name": "商品",
        "description": "可供销售的商品",
        "icon": "📦",
        "color": "#FFB900",
        "properties": [
          {
            "name": "productId",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "unitCost",
            "type": "decimal",
            "unit": "USD"
          },
          {
            "name": "discountPercent",
            "type": "decimal",
            "unit": "%"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "order-placedby-customer",
        "name": "由客户下单",
        "from": "order",
        "to": "customer",
        "cardinality": "many-to-one",
        "description": "下单的客户"
      },
      {
        "id": "order-contains-product",
        "name": "包含商品",
        "from": "order",
        "to": "product",
        "cardinality": "many-to-many",
        "description": "订单中包含的商品"
      }
    ],
    "rdfMetadata": {
      "ontologyIri": "http://example.org/ontology/retail-supply-chain-step-1-core-commerce/",
      "imports": [],
      "preservedSourceFeatures": []
    }
  },
  "bindings": []
}
