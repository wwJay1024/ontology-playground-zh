    "relationships": [
      {
        "id": "order-placedby-customer",
        "name": "由客户下单",
        "from": "order",
        "to": "customer",
        "cardinality": "many-to-one",
        "description": "下单的客户"
      },
      {
        "id": "order-contains-product",
        "name": "包含商品",
        "from": "order",
        "to": "product",
        "cardinality": "many-to-many",
        "description": "订单中包含的商品"
      },
      {
        "id": "order-has-lineitem",
        "name": "包含明细",
        "from": "order",
        "to": "orderline",
        "cardinality": "one-to-many",
        "description": "订单中的明细行"
      },
      {
        "id": "orderline-refs-product",
        "name": "指向商品",
        "from": "orderline",
        "to": "product",
        "cardinality": "many-to-one",
        "description": "该明细行对应的商品"
      },
      {
        "id": "product-in-category",
        "name": "属于分类",
        "from": "product",
        "to": "productcategory",
        "cardinality": "many-to-one",
        "description": "商品所属的分类"
      },
      {
        "id": "order-to-region",
        "name": "在区域履约",
        "from": "order",
        "to": "region",
        "cardinality": "many-to-one",
        "description": "订单履约所在的区域"
      },
      {
        "id": "store-in-region",
        "name": "位于区域",
        "from": "store",
        "to": "region",
        "cardinality": "many-to-one",
        "description": "门店所在的区域"
      },
      {
        "id": "shipment-fulfills-order",
        "name": "履约订单",
        "from": "shipment",
        "to": "order",
        "cardinality": "many-to-one",
        "description": "发运对应的订单"
      },
      {
        "id": "shipment-by-carrier",
        "name": "由承运商运输",
        "from": "shipment",
        "to": "carrier",
        "cardinality": "many-to-one",
        "description": "承运该批发运的承运商"
      },
      {
        "id": "shipment-from-warehouse",
        "name": "从仓库发出",
        "from": "shipment",
        "to": "warehouse",
        "cardinality": "many-to-one",
        "description": "发运出发的仓库"
      }
    ],
    "rdfMetadata": {
      "ontologyIri": "http://example.org/ontology/retail-supply-chain-step-4-fulfillment-logistics/",
      "imports": [],
      "preservedSourceFeatures": []
    }
  },
  "bindings": []
}
