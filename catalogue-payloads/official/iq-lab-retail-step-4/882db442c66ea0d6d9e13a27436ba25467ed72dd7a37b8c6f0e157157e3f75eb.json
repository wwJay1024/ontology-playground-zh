        "from": "shipment",
        "to": "carrier",
        "cardinality": "many-to-one",
        "description": "Which carrier handles the shipment"
      },
      {
        "id": "shipment-from-warehouse",
        "name": "ShipmentDepartedFromWarehouse",
        "from": "shipment",
        "to": "warehouse",
        "cardinality": "many-to-one",
        "description": "Which warehouse the shipment departed from"
      }
