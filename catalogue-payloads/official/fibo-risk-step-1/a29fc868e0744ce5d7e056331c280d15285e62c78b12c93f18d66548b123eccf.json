        "icon": "🏢",
        "color": "#0078D4",
        "properties": [
          {
            "name": "sectorCode",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "sectorName",
            "type": "string"
          },
          {
            "name": "description",
            "type": "string"
          }
        ]
      },
      {
