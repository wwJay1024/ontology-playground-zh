        "description": "经济门类下的细分层次，用于更精细的分类。",
        "icon": "🏗️",
        "color": "#00A9E0",
        "properties": [
          {
            "name": "subsectorCode",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "subsectorName",
            "type": "string"
          }
        ]
      },
      {
        "id": "industryGroup",
        "name": "行业组",
        "description": "带 NAICS 编码的行业组，含气候敏感性与周期性属性，供风险分析使用。",
        "icon": "🏭",
        "color": "#486991",
        "properties": [
          {
            "name": "naicsCode",
            "type": "string",
            "isIdentifier": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "cyclicality",
            "type": "string"
          },
          {
            "name": "climateSensitivity",
            "type": "string"
          },
          {
            "name": "essentialServices",
            "type": "boolean"
          },
          {
            "name": "description",
            "type": "string"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "partOfSector",
        "name": "属于门类",
        "from": "subsector",
        "to": "sector",
